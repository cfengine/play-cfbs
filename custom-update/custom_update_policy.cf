bundle agent custom_update_policy
{
  classes:
    "special_host" expression => fileexists("/etc/cfengine-special-host.flag");

  files:
    special_host::
      "${sys.inputdir}/files/special"
        perms => u_mog("0644", "root", "root" ),
        copy_from => u_remote_dcp_missing_ok("${sys.masterdir}/files/special", "${sys.policy_hub}"),
        depth_search => u_recurse("inf");
    any::
      "${sys.inputdir}/files/common"
        perms => u_mog("0644", "root", "root" ),
        copy_from => u_remote_dcp_missing_ok("${sys.masterdir}/files/common", "${sys.policy_hub}"),
        depth_search => u_recurse("inf");
}
